+      // 3D-box mode (natten_kt>0): the box's flat-index superset half-width is
+      // (kt-1)*H*W + (kh-1)*W + (kw-1); use it as the 1D range, and the mainloop
+      // applies the exact shift-clamp box mask on the (row,col) flat coords.
+      int blk_k0 = 0, blk_k1 = k_blocks, total_blk = k_blocks;
+      const int natten_window = p.natten_window;
+      const int nT = p.natten_T, nH = p.natten_H, nW = p.natten_W;
+      const int nkt = p.natten_kt, nkh = p.natten_kh, nkw = p.natten_kw;
+      int range_w = (nkt > 0) ? ((nkt - 1) * nH * nW + (nkh - 1) * nW + (nkw - 1))
+                              : natten_window;
