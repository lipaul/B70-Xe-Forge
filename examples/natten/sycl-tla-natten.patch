+      // Neighborhood attention: restrict the K-tile loop to the band covering
+      // this Q-tile's windows [q0-w, q0+BLK_Q-1+w]. Falls back to full range
+      // when natten_window==0 (plain attention / FA path unchanged).
+      int blk_k0 = 0, blk_k1 = k_blocks, total_blk = k_blocks;
+      const int natten_window = p.natten_window;
+      if (natten_window > 0) {
+        const int BLQ = get<0>(TileShapeQK{});
+        const int BLK = get<1>(TileShapeQK{});
+        const int q0 = blk_q * BLQ;
+        int lo = q0 - natten_window;
+        if (lo < 0) lo = 0;
+        const int hi = q0 + BLQ + natten_window;  // exclusive upper key bound
+        blk_k0 = lo / BLK;
+        blk_k1 = (hi + BLK - 1) / BLK;
+        const int total_tiles = (seq_len + BLK - 1) / BLK;
+        if (blk_k1 > total_tiles) blk_k1 = total_tiles;
+        if (blk_k0 > blk_k1) blk_k0 = blk_k1;
+        total_blk = blk_k1;
+      }
