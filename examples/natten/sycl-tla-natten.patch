+        const int BLQ = get<0>(TileShapeQK{});
+        const int BLK = get<1>(TileShapeQK{});
+        const int q0 = blk_q * BLQ;
+        int lo = q0 - range_w;
+        if (lo < 0) lo = 0;
+        const int hi = q0 + BLQ + range_w;  // exclusive upper key bound
+        blk_k0 = lo / BLK;
+        blk_k1 = (hi + BLK - 1) / BLK;
+        const int total_tiles = (seq_len + BLK - 1) / BLK;
+        if (blk_k1 > total_tiles) blk_k1 = total_tiles;
+        if (blk_k0 > blk_k1) blk_k0 = blk_k1;
